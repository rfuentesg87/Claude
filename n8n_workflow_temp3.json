    {
      "parameters": {
        "jsCode": "// Evaluar tracking line de line 1779540000 (P220510)\n// Paquete correcto: 334778 | Incorrecto: 333364 (sin stock en 34-MERMACADENA)\nconst resp = $input.first().json;\nconst lines = resp.value || [];\nconst existing = lines.length > 0 ? lines[0] : null;\n\nlet needs_fix = false;\nlet has_existing = false;\nlet existing_pkg = null;\nlet etag_url = null;\n\nif (existing) {\n  has_existing = true;\n  existing_pkg = existing.Package_No;\n  // @odata.id provee la URL canónica para DELETE en BC OData\n  etag_url = existing['@odata.id'] || null;\n  needs_fix = existing_pkg !== '334778';\n} else {\n  needs_fix = true; // no existe → crear\n}\n\nconsole.log(`Tracking P220510: has_existing=${has_existing}, existing_pkg=${existing_pkg}, needs_fix=${needs_fix}`);\n\nreturn [{ json: { needs_fix, has_existing, existing_pkg, etag_url } }];"
      },
