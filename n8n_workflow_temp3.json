      "id": "11111111-0011-0011-0011-111111111111",
      "name": "PATCH Lineas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2200, 300]
    },
    {
      "parameters": {
        "jsCode": "// Verificar resultados de patches. Errores ignorables: Planning Assignment, Package No. read-only.\nconst results = $input.all();\n\nconst IGNORED = ['Planning Assignment', \"Package No.'\"];\n\nconst failures = results.filter(r => {\n  const sc = r.json.statusCode;\n  if (!sc || sc < 300) return false;\n  const msg = r.json.body?.error?.message || JSON.stringify(r.json.body || '');\n  return !IGNORED.some(p => msg.includes(p));\n});\n\nconst ignored = results.filter(r => {\n  const sc = r.json.statusCode;\n  if (!sc || sc < 300) return false;\n  const msg = r.json.body?.error?.message || JSON.stringify(r.json.body || '');\n  return IGNORED.some(p => msg.includes(p));\n});\n\nconst ok = results.filter(r => !r.json.statusCode || r.json.statusCode < 300);\n\nconsole.log(`Patches: ${ok.length} OK, ${ignored.length} ignorados, ${failures.length} FALLOS reales`);\n\nif (failures.length > 0) {\n  const msgs = failures.slice(0, 5).map(r => {\n    const msg = r.json.body?.error?.message || JSON.stringify(r.json.body);\n    return `SC=${r.json.statusCode}: ${msg}`;\n  });\n  throw new Error('Patches no recuperables: ' + msgs.join(' | '));\n}\n\nreturn [{ json: { patches_ok: ok.length, patches_ignored: ignored.length, ready_to_post: true } }];"
      },
