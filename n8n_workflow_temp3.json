    {
      "parameters": {
        "jsCode": "// Construir lista de PATCHes para todas las líneas del diario PRODUCTO/GENERICO\nconst docNo = $('Set DocNo').first().json.docNo;\n\nconst LINE_LOT_MAP = {\n  1779519000: '26071', 1779522000: 'P358', 1779523000: '44682',\n  1779524000: '5S10232', 1779525000: '43665701', 1779526000: '43665701',\n  1779529000: 'IM202505', 1779530000: 'SP126055079', 1779531000: 'Y415',\n  1779534000: '25455', 1779536000: '260209', 1779537000: '260209',\n  1779538000: '260129', 1779539000: '250704', 1779540000: '260413',\n  1779541000: 'IM202432', 1779542000: '3140725', 1779543000: '3140725',\n  1779544000: 'KSK02350', 1779545000: 'IM202534', 1779546000: '2603',\n  1779547000: '2502227', 1779548000: 'IM202504', 1779549000: '241004',\n  1779550000: '3212', 1779551000: '260026', 1779553000: '260368',\n  1779554000: '2601', 1779557000: '26338', 1779559000: '260324',\n  1779560000: '260324', 1779561000: '26099', 1779562000: '2585',\n  1779563000: 'QL04', 1779564000: '25231', 1779565000: '241A',\n  1779566000: '25L08874'\n};\n\nconst LINE_PKG_MAP = {\n  1779519000: '332326', 1779520000: 'E247682', 1779521000: 'E305525',\n  1779522000: '321733', 1779523000: 'E281617', 1779524000: '324233',\n  1779525000: 'E276458', 1779526000: 'E276459', 1779527000: 'E276314',\n  1779528000: '323410', 1779529000: 'E284880', 1779530000: '330640',\n  1779531000: 'E310805', 1779532000: 'E310831', 1779533000: 'E278038',\n  1779534000: '328867', 1779535000: 'E312587', 1779536000: '322257',\n  1779537000: '331696', 1779538000: '321358', 1779539000: 'E288129',\n  1779540000: '334778',   // CORRECTO: pkg 334778 tiene stock en 34-MERMACADENA\n  1779541000: 'E304850',  // Package read-only en PATCH, ignorar error si aparece\n  1779542000: '327952', 1779543000: '330752', 1779544000: '328490',\n  1779545000: 'E306167', 1779546000: '332039', 1779547000: 'E289995',\n  1779548000: 'E285098', 1779549000: 'E276319', 1779550000: 'E273598',\n  1779551000: '322190', 1779552000: '330002', 1779553000: '329861',\n  1779554000: '330768', 1779555000: 'E284884', 1779556000: '328844',\n  1779557000: '325304', 1779558000: 'E295742', 1779559000: '330097',\n  1779560000: '330066', 1779561000: '332041', 1779562000: 'E302282',\n  1779563000: 'E312790', 1779564000: 'E293640', 1779565000: 'E314224',\n  1779566000: 'E304112'\n};\n\nconst BASE = \"https://api.businesscentral.dynamics.com/v2.0/5d57f2ac-22ea-444e-9f5e-de4a5c4b31ce/Production/ODataV4/Company('JOMIPSA')/ItemJournalWithReason\";\n\nconst lines = $input.first().json.value || [];\nconsole.log(`Preparando patches para ${lines.length} líneas con Document_No=${docNo}`);\n\nreturn lines.map(line => {\n  const lineNo = line.Line_No;\n  const body = { Document_No: docNo };\n  const lotNo = LINE_LOT_MAP[lineNo];\n  const pkgNo = LINE_PKG_MAP[lineNo];\n\n  if (lotNo) body.Lot_No = lotNo;\n  // Line 10000 (P000810) no está en LINE_PKG_MAP → Package_No no se incluye → correcto\n  // Esto evita el error \"Control 'Package No.' is read-only\"\n  if (pkgNo) body.Package_No = pkgNo;\n\n  const url = `${BASE}(Journal_Template_Name='PRODUCTO',Journal_Batch_Name='GENERICO',Line_No=${lineNo})`;\n  return { json: { lineNo, itemNo: line.Item_No, url, body: JSON.stringify(body) } };\n});"
      },
