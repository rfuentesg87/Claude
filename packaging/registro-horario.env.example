# =============================================================================
# Configuración de Registro Horario de Producción
# =============================================================================
# Este fichero debe llamarse "registro-horario.env" y estar en la MISMA carpeta
# que RegistroHorario.exe. Se lee al arrancar.
#
# Formato: UNA variable por línea, CLAVE=valor, sin espacios alrededor del "=".
# Las líneas que empiezan por # son comentarios.
#
# Ojo al editar con el Bloc de notas: guárdalo como UTF-8.
# =============================================================================


# --- OBLIGATORIO: clave para firmar las cookies de sesión --------------------
# Pon una cadena larga y aleatoria (mínimo 40 caracteres). Si cambia, todas las
# sesiones abiertas se invalidan. Genérala p. ej. en PowerShell con:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 50 | % {[char]$_})
RHP_SECRET_KEY=CAMBIAME-pon-aqui-una-cadena-larga-y-aleatoria

# --- Base de datos ----------------------------------------------------------
# "mssql" para el data warehouse (producción), "sqlite" para pruebas locales.
RHP_DB_BACKEND=mssql

# Cadena de conexión ODBC. Debe ir TODA EN UNA SOLA LÍNEA.
# Requiere el "ODBC Driver 18 for SQL Server" instalado en la máquina.
# El usuario se crea con sql/create_app_user.sql.
RHP_MSSQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:sqlserver-jomipsapde-prod-westeu-001.database.windows.net,1433;Database=sqldb-jomipsapde-prod-westeu-001;UID=app_registro_horario;PWD=CAMBIAME;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# --- Red --------------------------------------------------------------------
# 0.0.0.0 = escuchar en todas las interfaces (necesario para que otros equipos
# de la red accedan). Cambia el puerto si el 8000 ya está ocupado.
RHP_HOST=0.0.0.0
RHP_PORT=8000

# --- Seguridad de la sesión -------------------------------------------------
# true  -> la cookie solo viaja por HTTPS (lo correcto si hay TLS delante).
# false -> necesario si se accede por HTTP plano dentro de la intranet.
#          Menos seguro: la cookie de sesión viaja sin cifrar.
RHP_SESSION_COOKIE_SECURE=false

# Duración de la sesión en segundos (28800 = 8 horas, un turno).
RHP_SESSION_LIFETIME_SECONDS=28800

# --- Primer usuario ---------------------------------------------------------
# Solo se usa si la tabla gold.AppUsers está VACÍA, para poder entrar la primera
# vez. Cambia la contraseña y crea los usuarios reales con:
#   python manage.py create-user --username nombre.apellido --role cadena
RHP_DEFAULT_ADMIN_USER=admin
RHP_DEFAULT_ADMIN_PASSWORD=CAMBIAME-en-el-primer-arranque
RHP_DEFAULT_ADMIN_ROLE=planta
